# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Numeric chat, group, or channel ID. The bot must be allowed to post there.
TELEGRAM_CHAT_ID=-1001234567890

# Optional forum topic ID inside a Telegram supergroup.
# TELEGRAM_MESSAGE_THREAD_ID=123

# Private-chat users allowed to run bot commands. Comma-separated.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Telegram attaches this secret to every webhook request. Generate with:
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-64-character-hex-secret

# Optional delivery allowlists. When omitted, all verified payment events and
# durable outbox categories are delivered. This example sends only successful
# production subscriptions and App Store customer reviews:
# TELEGRAM_PAYMENT_NOTIFICATION_TYPES=SUBSCRIBED,DID_RENEW
# TELEGRAM_PAYMENT_ENVIRONMENTS=Production
# TELEGRAM_OUTBOX_CATEGORIES=app_review

# Limited-purpose key for the app registry API. Generate with:
# openssl rand -hex 32
IOS_PAYMENTS_ADMIN_API_KEY=replace-with-a-random-64-character-hex-key

# Mount /data as a persistent Coolify volume.
DATABASE_PATH=/data/ios-payments.sqlite

# Keep enabled to let Apple's library perform certificate revocation checks.
APPLE_ENABLE_ONLINE_CHECKS=true

# Optional: enable customer-review polling with an App Store Connect API key.
# Team keys require the issuer ID. Individual keys use KEY_TYPE=individual and
# do not use an issuer ID. Keep the downloaded .p8 file out of Git.
# APP_STORE_CONNECT_KEY_TYPE=team
# APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# APP_STORE_CONNECT_KEY_ID=ABC123DEFG
# APP_STORE_CONNECT_PRIVATE_KEY_BASE64=base64-encoded-p8-file
