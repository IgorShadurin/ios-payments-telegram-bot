{
  "name": "ios-payments-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Receive verified App Store Server Notifications from multiple iOS apps and forward them to Telegram.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.cli.json",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "apps": "node dist/scripts/apps.js",
    "apps:dev": "tsx scripts/apps.ts",
    "deliver": "node dist/scripts/deliver.js",
    "deliver:dev": "tsx scripts/deliver.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "better-sqlite3": "13.0.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@biomejs/biome": "2.3.14",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
