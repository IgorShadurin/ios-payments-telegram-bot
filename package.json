{
  "name": "ios-payments-telegram-bot",
  "version": "1.2.0",
  "private": true,
  "description": "Never miss iOS app payments, refunds, subscription changes, or new App Store reviews in Telegram.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.cli.json",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "apps": "node dist/scripts/apps.js",
    "apps:dev": "tsx scripts/apps.ts",
    "deliver": "node dist/scripts/deliver.js",
    "deliver:dev": "tsx scripts/deliver.ts",
    "reviews": "node dist/scripts/reviews.js",
    "reviews:dev": "tsx scripts/reviews.ts",
    "rates": "node dist/scripts/rates.js",
    "rates:dev": "tsx scripts/rates.ts",
    "analytics:setup": "node dist/scripts/analytics-setup.js",
    "analytics:setup:dev": "tsx scripts/analytics-setup.ts",
    "report:daily": "node dist/scripts/daily-report.js",
    "report:daily:dev": "tsx scripts/daily-report.ts",
    "telegram:configure": "node dist/scripts/configure-telegram.js",
    "telegram:configure:dev": "tsx scripts/configure-telegram.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "better-sqlite3": "13.0.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
